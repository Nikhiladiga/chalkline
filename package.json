{
  "name": "chalkline",
  "productName": "Chalkline",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI diagram editor on the Eraser Diagrams format",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "check": "tsc --noEmit -p tsconfig.json && biome check src e2e && vitest run",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "release:mac": "node scripts/release-mac.mjs",
    "brew:prepare": "node scripts/prepare-homebrew.mjs",
    "eval:s3": "vitest run --config vitest.eval.config.ts eval/s3.eval.ts",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eraserlabs/diagram-templates": "0.2.0",
    "@eraserlabs/diagrams": "0.2.0",
    "@eraserlabs/layout": "0.2.0",
    "@eraserlabs/protocol": "0.2.0",
    "@eraserlabs/render": "0.2.0",
    "@eraserlabs/resolve": "0.2.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "codemirror": "^6.0.2",
    "cross-spawn": "7.0.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "happy-dom": "^20.14.5",
    "ignore": "7.0.5",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "author": "Nikhil Adiga"
}
